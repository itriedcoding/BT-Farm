{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BT Farm",
  "version": "1.3.0",
  "identifier": "com.btfarm.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BT Farm",
        "width": 1480,
        "height": 940,
        "minWidth": 1120,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0a0c11"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "BT Farm",
    "copyright": "© 2026 BT Farm",
    "category": "DeveloperTool",
    "shortDescription": "Cloud phone and automation control plane",
    "longDescription": "Provision Linux infrastructure on E2B, Boat, boxd, Daytona and Freestyle, manage Android devices over ADB, stream real device screens, and run automated workflows.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
